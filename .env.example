# 이 파일을 복사해서 .env 를 만들고 값을 채우세요.
#   copy .env.example .env      (PowerShell)
#
# .env 에는 비밀번호가 들어가므로 깃에 올리지 않습니다 (.gitignore 에 등록됨).

# 형식: postgres://아이디:비밀번호@주소:포트/데이터베이스이름
# 로컬에서 PostgreSQL 을 기본 설정으로 설치했다면 아이디는 postgres 입니다.
DATABASE_URL=postgres://postgres:비밀번호@localhost:5432/goldenbell-server

# 웹 서버가 쓸 포트 (비워두면 3000)
PORT=3000
